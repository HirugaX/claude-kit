{
  "description": "Os ganchos do nucleo (plugins/nucleo/ganchos/, F2b) e o das cores das pastas. Em todo projeto: o modelo (PreModelSwitch), a abertura (aviso de modelo e esforço, pull do kit, medição semanal, balanço vencido), o lembrete do effort no Agent e as cores. Só onde existe docs/ESTADO.md: o resto da abertura, o portão (Stop), a guarda de escrita em pasta de dado e a fila (AskUserQuestion e PermissionRequest na execução largada).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/ganchos/abertura.py\" || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PreModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/ganchos/modelo.py\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/ganchos/portao.py\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/ganchos/guarda.py\" || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/ganchos/fila.py\" || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/ganchos/despacho.py\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/ganchos/fila.py\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/pastas/scripts/gancho.py\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
